# For running the API with `go run` against the containers started with
# docker-compose.dev.yml. Values must match the project's root .env.
DATABASE_URL=postgres://itassist:changeme-storage-secret@127.0.0.1:5432/itassist?sslmode=disable
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=itassist
S3_SECRET_KEY=changeme-storage-secret
COOKIE_SECURE=0
